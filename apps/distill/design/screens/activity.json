 "boards": [
  {
   "file": "Activity.dc.html",
   "title": "Activity · what changed, when, from where",
   "heading": "Activity · History → Activity",
   "intro": "The owner lost track of three chats and a script collector they had deleted themselves; nothing could show it. Activity answers <b>what changed, when, and from where</b> for chats, collectors, actions, batches, the queue, connections and settings. It lives under <b>History</b> as a fourth sub-item, next to Jobs, Ask chats and Actions: History is where the app already shows what happened, and where a missing chat is looked for first. Calm by default: one line per entry, day headings, faint “time · source”, colour only for failures. The detail shows what was there and how to get it back: <b>Restore</b> from Distill’s trash (deleted chats and collectors, 30 days), <b>Show in Finder</b> for queue files in the macOS Trash, or why nothing was kept. Never secrets or content: scripts appear as their size and line count. Core, API (<code>GET /v1/activity</code>) and CLI (<code>distill activity</code>) are built; this UI is not.",
   "width": 2520,
   "sections": [
    {
     "row": [
      "activity",
      "activity-filters"
     ],
     "style": "display: flex; gap: 40px; align-items: flex-start"
    },
    {
     "row": [
      "activity-filtered",
      "activity-restored"
     ],
     "style": "display: flex; gap: 40px; align-items: flex-start"
    },
    {
     "row": [
      "activity-empty",
      "activity-no-matches"
     ],
     "style": "display: flex; gap: 40px; align-items: flex-start"
    },
    {
     "title": "Narrow window (890 pt)",
     "sub": "No detail column: the list takes the width, and an entry opens in its place."
    },
    {
     "row": [
      "activity-narrow",
      "activity-narrow-detail"
     ],
     "style": "display: flex; gap: 40px; align-items: flex-start"
    },
    {
     "title": "The detail for other kinds of entries"
    },
    {
     "grid": [
      "activity-card-queue",
      "activity-card-settings",
      "activity-card-expired",
      "activity-card-batch"
     ],
     "cols": 4
    }
   ]
  }
 ]
}
